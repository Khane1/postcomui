    let isMobileFilterOpen = $state(false);

    /// routes/products/+page.svelte
    let favoritedMap = $derived(
        (appState.favorites || []).reduce((acc, id) => {
            acc[id] = true;
            return acc;
        }, {}),
    );

    const categoriesList = [
        "Agro Products",
